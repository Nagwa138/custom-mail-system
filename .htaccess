Options -Indexes

# Block direct access to PHP internals
<FilesMatch "^(config|Mailer|TemplateRenderer|Logger)\.php$">
    Require all denied
</FilesMatch>

# Block direct access to logs
<IfModule mod_authz_core.c>
    <DirectoryMatch "^.*/logs/">
        Require all denied
    </DirectoryMatch>
</IfModule>

# Block direct access to templates folder
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Route everything to send.php
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ send.php [QSA,L]
</IfModule>

# Security headers
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
</IfModule>
